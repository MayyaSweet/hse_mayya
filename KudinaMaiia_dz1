      "source": [
        "def change_array(array: np.array) -> np.array:\n",
        "  zamena = np.where(array % 2 == 0, array ** 2, np.sin(array)) # заменяем четные числа на их квадраты, а нечетные на их синусы\n",
        "  return np.round(zamena, 2) # выводим, округляя до 2 знаков после запятой"
