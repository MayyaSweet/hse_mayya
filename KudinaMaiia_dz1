      "source": [
        "def result_mark(weights: np.array, marks: np.array) -> int:\n",
        "  proizv = np.dot(marks, weights) # перемножаем веса на оценки\n",
        "  round_result = np.round(proizv) # округляем полученное до ближайшей целой оценки\n",
        "  return round_result"
