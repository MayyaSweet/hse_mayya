      "outputs": [],
      "source": [
        "def cosine_similarity(vec1, vec2):\n",
        "    chislitel = np.sum(vec1*vec2) # вычисляем числитель как скалярное произведение\n",
        "    znamenatel = np.sqrt(np.sum(vec1**2)) * np.sqrt(np.sum(vec2**2)) # вычиляем знаменатель как произведение норм A и B\n",
        "    return chislitel/znamenatel # выводим по формуле"
      ]
