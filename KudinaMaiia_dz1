      }
    },
    {
      "cell_type": "code",
      "execution_count": 25,
      "metadata": {
        "id": "c52pnmW6Wdwv"
      },
      "outputs": [],
      "source": [
        "def sum_counterdiagonal_elements(array):\n",
        "    array_new = array[:, ::-1] # отзеркалим массив \"по горизонтали\", чтобы побочная диагональ стала основной (можно было и по вертикали)\n",
        "    diag = np.diag(array_new) # извлечем цифры с основной диагонали\n",
        "    sum = np.sum(diag) # просуммируем их\n",
        "    return sum"
      ]
