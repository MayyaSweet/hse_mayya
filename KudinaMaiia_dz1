      "outputs": [],
      "source": [
        "def flatten_and_sort_transposed(array: np.array) -> np.array:\n",
        "    array_transposed = np.transpose(array) # транспонируем матрицу\n",
        "    array_reshaped = array_transposed.reshape(-1) # приводим к виду одномерного массива\n",
        "    array_int8 = array_reshaped.astype(np.int8) # преобразуем в тип int8\n",
        "    array_sorted = np.sort(array_int8)[::-1] # сортируем по возврастанию и разворачиваем (сортировка по убыванию)\n",
        "    return array_sorted"
      ]
