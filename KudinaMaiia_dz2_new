        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/usr/local/lib/python3.12/dist-packages/numpy/_core/fromnumeric.py:84: FutureWarning: The behavior of DataFrame.sum with axis=None is deprecated, in a future version this will reduce over both axes and return a scalar. To retain the old behavior, pass axis=0 (or do not pass axis)\n",
            "  return reduction(axis=axis, out=out, **passkwargs)\n"
          ]
        }
      ],
      "source": [
        "df_new = pd.melt(df, id_vars=['Platform'], value_vars=['Follower Count', 'Posts Per Week', 'Ad Spend (USD)',\n",
        "              'Conversion Rate', 'Engagement Rate', 'Campaign Reach'], var_name='Metric', value_name='Value') # формирую новый датафрейм, фиксируя платформы\n",
        "to_group = df_new.groupby(['Platform', 'Metric']) # сгруппируем по платформе и метрике\n",
        "modes_max = to_group.agg(lambda x: x.mode().max()) # возьмем максимум из мод (тк иногда он возвращает список)\n",
        "summ_result = np.sum(modes_max) # суммируем моды\n",
        "print(summ_result)"
      ]
    },
